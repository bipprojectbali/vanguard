        </mxCell>
        <mxCell id="r4_own" value="HANYA desa yg dikelola (assigned_csm / backup_csm = dirinya). 1 CSM utama per desa (§8.1)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
