        <!-- ===== HUB ===== -->
        <mxCell id="account" value="accounts  (DESA — HUB)&#xa;&#xa;account_owner · assigned_csm · backup_csm&#xa;Semua modul menyambung ke sini" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="560" y="480" width="290" height="100" as="geometry" />
