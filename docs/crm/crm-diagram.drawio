        <mxCell id="ticket" value="tickets&#xa;(+ SLA)&#xa;Owner: Support Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
