        <!-- ===== ACTIVITIES ===== -->
        <mxCell id="activity" value="activities  (polymorphic, kind enum)&#xa;&#xa;task · meeting · call · chat · email · note&#xa;+ activity_attendees&#xa;target_type / target_id → ke SEMUA entity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;" vertex="1" parent="1">
