          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- ===== EDGES: hub relations ===== -->
        <mxCell id="e_acc_con" value="1:N" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="account" target="contact">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_acc_sub" value="1:N" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="account" target="sub">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_acc_cs" value="1:1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="account" target="cs">
          <mxGeometry relative="1" as="geometry" />
