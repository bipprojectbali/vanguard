<mxfile host="drawio.wibudev.com" agent="claude-code" pages="8">
  <diagram id="dataflow" name="Alur Data CRM">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- ===== TITLE ===== -->
        <mxCell id="title" value="Alur Data CRM Desa+ — dari Prospek ke Retensi" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Kotak = tabel. Panah tebal = alur konversi/lifecycle. Panah putus-putus = referensi (FK). Warna = domain modul." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="900" height="24" as="geometry" />
        </mxCell>
        <!-- ===== SWIMLANE: MASTER / KATALOG ===== -->
        <mxCell id="lane_master" value="MASTER / KATALOG (dikelola Admin)" style="swimlane;horizontal=0;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1500" height="120" as="geometry" />
