        <!-- footer note -->
        <mxCell id="rfoot" value="CATATAN: Isolasi antar-WORKSPACE = RLS Postgres (sumbu 2). Isolasi antar-DESA (Ownership Rule di atas) = filter di LAYER APLIKASI (query sqlc: WHERE account_owner=$uid OR assigned_csm=$uid ...), BUKAN RLS lapis kedua. Field-Level Security (§5) disamarkan di HANDLER, bukan view — kolom asli tetap ada." style="text;html=1;fontSize=12;align=left;fontColor=#8a3a36;fontStyle=2;" vertex="1" parent="1">
