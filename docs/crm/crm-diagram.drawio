          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_plan_sub" style="endArrow=open;html=1;strokeWidth=1;strokeColor=#6c8ebf;dashed=1;" edge="1" parent="1" source="plan" target="sub">
          <mxGeometry relative="1" as="geometry" />
