        <mxCell id="sla" value="sla_policies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane_master">
          <mxGeometry x="290" y="45" width="140" height="55" as="geometry" />
