  <diagram id="roles" name="Kewenangan Role">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rtitle" value="Kewenangan Role — 3 Sumbu Ortogonal + Ownership Data" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rsub" value="Ketiga sumbu berdiri sendiri (tak saling menurunkan) &amp; disimpan per-MEMBERSHIP (user × tenant), bukan per-user. Keputusan bypass RLS SELALU dari sumbu Platform, tak pernah dari data." style="text;html=1;fontSize=12;fontColor=#555555;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1200" height="24" as="geometry" />
        </mxCell>
        <!-- ===== AXIS 1: PLATFORM ===== -->
        <mxCell id="ax1" value="SUMBU 1 — PLATFORM&#xa;(operator Desa+ sbg perusahaan)&#xa;disimpan: ENV + platform_staff (tanpa RLS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="460" height="230" as="geometry" />
        </mxCell>
        <mxCell id="ax1a" value="super_admin — akses /dev penuh, atur kuota, mode tenancy, kelola staff, suspend workspace. Dari SUPER_ADMIN_EMAILS. Deny-default; hanya ini yg lolos platform:settings." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="ax1">
          <mxGeometry x="15" y="70" width="430" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ax1b" value="staff — /dev terbatas (dev:users). TIDAK boleh suspend tenant / kelola staff / ubah platform:settings." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="ax1">
          <mxGeometry x="15" y="150" width="430" height="60" as="geometry" />
        </mxCell>
        <!-- ===== AXIS 2: TENANT ===== -->
        <mxCell id="ax2" value="SUMBU 2 — TENANT (workspace)&#xa;disimpan: memberships.role&#xa;(template bawaan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="110" width="460" height="230" as="geometry" />
        </mxCell>
        <mxCell id="ax2a" value="owner — kelola workspace penuh: ganti nama, kelola anggota, archive. Kuota dihitung dari role ini." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="ax2">
          <mxGeometry x="15" y="70" width="430" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ax2b" value="admin — operasional workspace (kelola anggota, nama app di mode single). GuardSetRole pakai &gt;= (tak bisa angkat sesama admin)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="ax2">
          <mxGeometry x="15" y="125" width="430" height="55" as="geometry" />
        </mxCell>
        <mxCell id="ax2c" value="member — pakai workspace, tak kelola anggota." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="ax2">
          <mxGeometry x="15" y="185" width="430" height="35" as="geometry" />
        </mxCell>
        <!-- ===== AXIS 3: BUSINESS ===== -->
        <mxCell id="ax3" value="SUMBU 3 — BISNIS (peran CRM)&#xa;disimpan: memberships.business_role (KOLOM BARU)&#xa;NULL = tanpa peran CRM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="110" width="480" height="230" as="geometry" />
        </mxCell>
        <mxCell id="ax3note" value="Setiap peran = 2 lapis: PERMISSION SET (aksi apa) + OWNERSHIP RULE (data desa siapa). Detail di tabel bawah." style="text;html=1;fontSize=11;align=left;fontColor=#3d6b28;spacingLeft=6;" vertex="1" parent="ax3">
          <mxGeometry x="15" y="65" width="450" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ax3roles" value="admin · manager · sales · csm · support" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="ax3">
          <mxGeometry x="15" y="130" width="450" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ax3warn" value="Ortogonal dari sumbu 1 &amp; 2: satu orang bisa owner+csm di workspace A, member+sales di B." style="text;html=1;fontSize=11;align=left;fontColor=#3d6b28;spacingLeft=6;" vertex="1" parent="ax3">
          <mxGeometry x="15" y="180" width="450" height="40" as="geometry" />
        </mxCell>
        <!-- ===== MATRIX: business role x data ===== -->
        <mxCell id="mtitle" value="Matriks Sumbu 3 — Peran Bisnis × Data yang Boleh Disentuh" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="900" height="30" as="geometry" />
        </mxCell>
        <!-- header row -->
        <mxCell id="h_role" value="Peran" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="h_perm" value="Permission Set (aksi utama)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="190" y="420" width="470" height="50" as="geometry" />
        </mxCell>
        <mxCell id="h_own" value="Ownership Rule (data desa mana)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="420" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="h_fls" value="Field disembunyikan (§5 FLS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1020" y="420" width="500" height="50" as="geometry" />
        </mxCell>
        <!-- admin -->
        <mxCell id="r1_role" value="admin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r1_perm" value="Konfigurasi sistem CRM: plans, sla_policies, playbooks, kb_articles, assign ownership desa, kelola business_role anggota." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="190" y="470" width="470" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r1_own" value="SEMUA desa dalam workspace." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="660" y="470" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r1_fls" value="(tidak ada — lihat semua)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1020" y="470" width="500" height="80" as="geometry" />
        </mxCell>
        <!-- manager -->
        <mxCell id="r2_role" value="manager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r2_perm" value="Approval &amp; visibilitas lintas-tim. Melihat pipeline/CS/tiket semua tim, approve deal/quote, tak wajib config sistem." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="190" y="550" width="470" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r2_own" value="SEMUA desa (read lintas-tim untuk pengawasan)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="660" y="550" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r2_fls" value="Terikat FLS KECUALI ARR (§8.3) — boleh lihat ARR untuk forecast." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1020" y="550" width="500" height="80" as="geometry" />
        </mxCell>
        <!-- sales -->
        <mxCell id="r3_role" value="sales" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r3_perm" value="Kelola leads, deals, quotes, contacts. Konversi lead → account+contact+deal. Aktivitas sales (activity_context=sales)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="190" y="630" width="470" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r3_own" value="HANYA desa yg di-assign (account_owner = dirinya). Assign manual per-desa, bukan teritori administratif." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
