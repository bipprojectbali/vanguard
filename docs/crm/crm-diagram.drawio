        <mxCell id="e_acc_ticket" value="1:N" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="account" target="ticket">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cs_child" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="cs" target="cschild">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- renewal self loop -->
        <mxCell id="e_sub_renew" value="renewal&#xa;previous_subscription_id" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#d6b656;fontColor=#9a7d1a;rounded=1;exitX=1;exitY=0.25;entryX=1;entryY=0.75;" edge="1" parent="1" source="sub" target="sub">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1170" y="500" />
              <mxPoint x="1170" y="555" />
