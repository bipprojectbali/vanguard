          <mxGeometry x="620" y="290" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="quote" value="quotes&#xa;+ quote_items&#xa;&#xa;snapshot harga" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="290" width="160" height="90" as="geometry" />
