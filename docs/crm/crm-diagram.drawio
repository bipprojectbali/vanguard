        <mxCell id="r4_perm" value="Kelola customer_success, success_plans, trainings, impl_tasks, surveys, renewal (subscriptions), engagement (activity_context=cs)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
